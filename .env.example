# Copy to .env and fill in values for local development.
# In production, all secrets are loaded from GCP Secret Manager.

# GCP (local dev only — prod uses service account)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Database
DATABASE_URL=postgresql://social:social@localhost:5432/social_assistant

# GitHub
GITHUB_TOKEN=ghp_...

# Telegram Bot
TELEGRAM_BOT_TOKEN=...
TELEGRAM_CHAT_ID=...    # your personal chat ID for approvals

# Bluesky
BLUESKY_HANDLE=your.bsky.social
BLUESKY_PASSWORD=...

# X / Twitter (OAuth 1.0a — from developer.twitter.com → Consumer Keys + Authentication Tokens)
X_API_KEY=...
X_API_SECRET=...
X_ACCESS_TOKEN=...
X_ACCESS_TOKEN_SECRET=...
